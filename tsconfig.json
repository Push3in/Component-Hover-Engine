{
  // TypeScript is being added file by file: only .ts/.tsx files are checked.
  // Vite compiles them as-is; `npm run typecheck` checks the types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": ["film/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
